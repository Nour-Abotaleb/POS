APP_NAME="ZATCA Proxy Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://your-zatca-proxy.sa

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zatca_proxy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ZATCA Configuration
ZATCA_ENVIRONMENT=production
ZATCA_DEVELOPER_ENDPOINT=https://gw-apic-gov.gazt.gov.sa/e-invoicing/developer-portal
ZATCA_SIMULATION_ENDPOINT=https://gw-apic-gov.gazt.gov.sa/e-invoicing/simulation
ZATCA_PRODUCTION_ENDPOINT=https://gw-apic-gov.gazt.gov.sa/e-invoicing/core

# API Security
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=60
API_SECRET_KEY=your-super-secret-api-key-here

# Client Authentication
ALLOWED_CLIENT_IPS=
REQUIRE_API_KEY=true
REQUIRE_CLIENT_CERTIFICATE=false

# Monitoring & Logging
ENABLE_REQUEST_LOGGING=true
ENABLE_RESPONSE_LOGGING=true
LOG_ZATCA_REQUESTS=true
LOG_ZATCA_RESPONSES=true

# Performance
CACHE_ZATCA_RESPONSES=true
CACHE_TTL=3600
ENABLE_COMPRESSION=true

# Webhook Configuration (Optional)
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=