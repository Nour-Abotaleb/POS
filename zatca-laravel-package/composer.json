{
    "name": "your-vendor/zatca-laravel",
    "description": "Laravel package for ZATCA (Saudi Arabia E-Invoicing) Phase 2 integration",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "zatca", "saudi-arabia", "e-invoicing", "vat", "tax"],
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "salla/zatca": "^3.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "YourVendor\\ZatcaLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YourVendor\\ZatcaLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YourVendor\\ZatcaLaravel\\ZatcaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}